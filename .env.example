# Copy to .env and fill in. Never commit .env
DATABASE_URL=postgres://ledger:ledger@localhost:5433/licenseledger
MONGO_URL=mongodb://localhost:27017/licenseledger
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=licenseledger
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# password for the ll_admin / ll_it_staff / ll_employee database logins (set by `npm run db:roles`)
LL_ROLE_PASSWORD=change-me-before-the-demo
